type Point is record
    var x: integer
    var y: integer
end

routine moveRight(p: Point, distance: integer) is
    // comment
    p.x := p.x + distance
end

routine main() is
    var myPoint: Point
    myPoint.x := 5
    myPoint.y := 10

    moveRight(myPoint, 3)

    print "New X coordinate is: ", myPoint.x
end